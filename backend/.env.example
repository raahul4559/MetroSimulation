# Copy to .env and `export $(grep -v '^#' .env | xargs)` before running ./mvnw spring-boot:run,
# or export these directly. All have working local-dev defaults in application.yml.

DB_URL=jdbc:postgresql://localhost:5432/metro_simulation
DB_USERNAME=metro_user
DB_PASSWORD=metro_password

SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

SIMULATION_TICK_INTERVAL_MS=1000
SIMULATION_TIME_SCALE=1.0

# Station PA announcements — all optional. Without GOOGLE_CLOUD_TTS_API_KEY the app runs fine and
# falls back to browser speech synthesis, then text-only captions (see docs/architecture.md).
# Get a key: GCP Console -> enable "Cloud Text-to-Speech API" -> Credentials -> Create API key.
GOOGLE_CLOUD_TTS_API_KEY=
# ANNOUNCEMENT_AUDIO_CACHE_DIR=./data/audio-cache
# FFMPEG_PATH=ffmpeg
# GOOGLE_TTS_VOICE_EN=en-IN-Neural2-A
# GOOGLE_TTS_VOICE_HI=hi-IN-Neural2-A
# GOOGLE_TTS_VOICE_KN=kn-IN-Standard-A

# Realtime digital twin — all optional; see docs/realtime.md. Nothing is polled unless a URL is set.
# REALTIME_MODE=AUTO   # AUTO | LIVE | GTFS_REALTIME | SCHEDULE | SIMULATION
# Authorized/official operator feed (JSON contract in docs/realtime.md):
# REALTIME_OFFICIAL_URL=
# REALTIME_OFFICIAL_AUTH_HEADER_VALUE=
# GTFS-Realtime feed (protobuf). The three may be the same URL:
# REALTIME_GTFS_VEHICLE_POSITIONS_URL=
# REALTIME_GTFS_TRIP_UPDATES_URL=
# REALTIME_GTFS_ALERTS_URL=
# REALTIME_GTFS_AUTH_HEADER_NAME=
# REALTIME_GTFS_AUTH_HEADER_VALUE=
